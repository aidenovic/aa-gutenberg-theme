{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "48rem",
      "wideSize": "75rem"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        {
          "slug": "ink",
          "name": "Text",
          "color": "#20242b"
        },
        {
          "slug": "navy",
          "name": "Dunkle Fläche",
          "color": "#303744"
        },
        {
          "slug": "blue",
          "name": "Blau",
          "color": "#245a80"
        },
        {
          "slug": "primary",
          "name": "Akzent",
          "color": "#245a80"
        },
        {
          "slug": "white",
          "name": "Hintergrund",
          "color": "#ffffff"
        },
        {
          "slug": "ocean",
          "name": "Helle Fläche",
          "color": "#e9edf1"
        },
        {
          "slug": "focus",
          "name": "Tastaturfokus",
          "color": "#805500"
        },
        {
          "slug": "error",
          "name": "Fehlertext",
          "color": "#a32135"
        },
        {
          "slug": "footer",
          "name": "Sekundärtext",
          "color": "#434a54"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "%",
        "vw",
        "vh"
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
          "name": "Systemschrift",
          "slug": "system"
        },
        {
          "fontFamily": "Georgia, \"Times New Roman\", serif",
          "name": "Serif",
          "slug": "serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Klein / Bedienelemente",
          "size": "1rem",
          "fluid": false
        },
        {
          "slug": "body",
          "name": "Fließtext",
          "size": "clamp(1.0625rem, 0.9896vw, 1.1875rem)",
          "fluid": false
        },
        {
          "slug": "lead",
          "name": "Einleitung",
          "size": "clamp(1.25rem, 1.302vw, 1.5625rem)",
          "fluid": false
        },
        {
          "slug": "heading",
          "name": "Abschnitt",
          "size": "clamp(1.75rem, 1.823vw, 2.1875rem)",
          "fluid": false
        },
        {
          "slug": "feature",
          "name": "Große Abschnittsüberschrift",
          "size": "clamp(2.25rem, 2.865vw, 3.4375rem)",
          "fluid": false
        },
        {
          "slug": "display",
          "name": "Headline",
          "size": "clamp(2.75rem, 3.333vw, 4rem)",
          "fluid": false
        }
      ],
      "lineHeight": true
    },
    "custom": {
      "aa": {
        "buttonRadius": "0.35rem",
        "buttonTracking": "0",
        "buttonMinHeight": "2.75rem"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|white",
      "text": "var:preset|color|ink"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "margin": {
        "top": "0",
        "bottom": "0"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|system",
      "fontSize": "1.125rem",
      "lineHeight": "1.6"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var:preset|color|primary"
        },
        "typography": {
          "textDecoration": "underline"
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|system",
          "fontWeight": "700",
          "fontSize": "var:preset|font-size|heading",
          "lineHeight": "1.15"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|display"
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|primary",
          "text": "var:preset|color|white"
        },
        "border": {
          "radius": "0.35rem"
        },
        "typography": {
          "textTransform": "none",
          "letterSpacing": "0",
          "fontWeight": "600"
        },
        "spacing": {
          "padding": {
            "top": "0.75rem",
            "right": "1.25rem",
            "bottom": "0.75rem",
            "left": "1.25rem"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header – Logo und Navigation",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer – Website-Name und Untertitel",
      "area": "footer"
    }
  ]
}
